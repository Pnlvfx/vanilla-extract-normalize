{
  "name": "vanilla-extract-normalize",
  "version": "1.4.0",
  "description": "Normalizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pnlvfx/vanilla-extract-normalize.git"
  },
  "license": "MIT",
  "author": {
    "email": "simonegauli@gmail.com",
    "name": "Simone Gauli"
  },
  "sideEffects": [
    "./dist/**/*.css.js"
  ],
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && eslint && tsc -p tsconfig.build.json",
    "lint": "eslint",
    "ncu": "pnpm update --interactive --latest",
    "reference": "node tools/reference.ts",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@goatjs/dbz": "^2.91.0",
    "@goatjs/download": "^2.38.0",
    "@goatjs/node": "^2.39.0",
    "@goatjs/node-eslint": "^3.45.0",
    "@goatjs/rimraf": "^2.15.0",
    "@goatjs/typescript-config": "2.2.0",
    "@types/node": "^26.6.5",
    "@vanilla-extract/css": "^1.21.3",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@vanilla-extract/css": "*"
  },
  "packageManager": "pnpm@12.15.0"
}
