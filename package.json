{
  "name": "vanilla-extract-normalize",
  "version": "1.3.0",
  "description": "Normalizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pnlvfx/vanilla-extract-normalize.git"
  },
  "license": "MIT",
  "author": {
    "email": "simonegauli@gmail.com",
    "name": "Simone Gauli"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && eslint && tsc -p tsconfig.build.json",
