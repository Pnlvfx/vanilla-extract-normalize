{
  "name": "vanilla-extract-normalize",
  "version": "1.3.0",
  "description": "Normalizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pnlvfx/vanilla-extract-normalize.git"
  },
  "license": "MIT",
  "author": {
    "email": "simonegauli@gmail.com",
    "name": "Simone Gauli"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && eslint && tsc -p tsconfig.build.json",
    "lint": "eslint",
    "ncu": "node tools/update.ts && pnpm update --interactive --latest",
    "reference": "node tools/reference.ts",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@goatjs/dbz": "^2.64.0",
    "@goatjs/download": "^2.32.0",
    "@goatjs/node": "^2.33.0",
    "@goatjs/node-eslint": "^3.16.0",
    "@goatjs/rimraf": "^2.12.0",
    "@goatjs/typescript-config": "2.2.0",
    "@types/node": "^26.2.0",
    "@vanilla-extract/css": "^1.21.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@vanilla-extract/css": "*"
  },
  "packageManager": "pnpm@11.25.0"
}
