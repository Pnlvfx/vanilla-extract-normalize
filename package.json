    "prepublishOnly": "yarn test && eslint",
    "reference": "node tools/reference.ts",
    "tsc": "tsc --noEmit",
    "update": "yarn upgrade-interactive"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@goatjs/dbz": "^2.64.0",
    "@goatjs/download": "^2.32.0",
    "@goatjs/node": "^2.33.0",
    "@goatjs/node-eslint": "^3.16.0",
    "@goatjs/rimraf": "^2.12.0",
    "@goatjs/typescript-config": "2.2.0",
    "@types/node": "^26.2.0",
    "@vanilla-extract/css": "^1.21.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@vanilla-extract/css": "*"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
